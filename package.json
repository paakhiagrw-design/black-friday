{
  "name": "black-friday",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "node database/init.mjs",
    "db:seed": "node database/seed.mjs",
    "db:reset": "node database/init.mjs && node database/reset.mjs && node database/seed.mjs",
    "test:store": "node --experimental-strip-types --test tests/store/*.test.mjs",
    "test:store:http": "node tests/store/run-http.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
