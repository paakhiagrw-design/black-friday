{
  "name": "black-friday",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "node database/startup.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:init": "node database/init.mjs",
    "db:seed": "node database/seed.mjs",
    "db:reset": "node database/init.mjs && node database/reset.mjs && node database/seed.mjs",
    "test": "vitest run",
    "test:operations": "node --experimental-strip-types --test lib/operations/workflow.test.mjs lib/operations/vision/comparison.test.mjs lib/operations/vision/origin.test.mjs tests/storage.test.mjs",
    "test:store": "node --experimental-strip-types --test tests/store/*.test.mjs",
    "test:store:http": "node tests/store/run-http.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "leaflet": "^1.9.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
